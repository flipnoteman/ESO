// build.rs (runs on your PC, not on the PSP)
use std::{env, fs, path::{Path, PathBuf}, process::Command};

use bytemuck::{Pod, Zeroable};

#[repr(C, align(16))]
#[derive(Copy, Clone)]
struct Vertex {
    pos: [f32; 3],
    uv:  [f32; 2],
}

unsafe impl Zeroable for Vertex {}
unsafe impl Pod for Vertex {}

fn to_wsl(path: &std::path::Path) -> String {
    // C:\Users\sammy\foo → /mnt/c/Users/sammy/foo
    let mut s = path.to_str().unwrap().replace('\\', "/");
    if let Some(drive) = s.get(..2) {
        if drive.ends_with(':') {
            let drive_letter = drive.chars().next().unwrap().to_ascii_lowercase();
            s.replace_range(..2, &format!("/mnt/{}", drive_letter));
        }
    }
    s
}

fn main() {
    // --- prepare paths ----------------------------------------------------
    let out_dir   = PathBuf::from(env::var("OUT_DIR").unwrap());
    let bin_path  = out_dir.join("chicken.bin");        // raw bytes
    let obj_path  = out_dir.join("chicken.o");          // wrapper object
    let wsl_bin   = to_wsl(&bin_path);
    let wsl_obj   = to_wsl(&obj_path);

    // --- parse OBJ & write vertex blob ------------------------------------
    let (models, _) = tobj::load_obj(
        "./assets/chicken.obj",
        &tobj::LoadOptions { triangulate: true, single_index: true, ..Default::default() }
    ).expect("OBJ load failed");
    let mesh = &models[0].mesh;

    let mut verts = Vec::<Vertex>::with_capacity(mesh.indices.len());
    for &i in &mesh.indices {
        let i = i as usize;
        verts.push(Vertex {
            pos: [ mesh.positions[3*i], mesh.positions[3*i+1], mesh.positions[3*i+2] ],
            uv : [ mesh.texcoords[2*i], 1.0 - mesh.texcoords[2*i+1] ],
        });
    }
    fs::write(&bin_path, bytemuck::cast_slice(&verts)).unwrap();

    let cd  = to_wsl(&out_dir);                 // stay in OUT_DIR → short symbols
    let cmd = format!(
        "cd '{}' && \\
         /home/sam/pspdev/bin/psp-objcopy -I binary chicken.bin chicken.o",
        cd
    );

    let status = Command::new("wsl")
        .args(["bash", "-c", &cmd])
        .status()
        .expect("failed to spawn objcopy");
    assert!(status.success(), "objcopy failed with {}", status);

    // --- pass wrapper object to Rust linker -------------------------------
    println!("cargo:rustc-link-arg-bins={}", obj_path.display());
    println!("cargo:rerun-if-changed=assets/chicken.obj");
}
